{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoEditorFree",
  "version": "0.1.0",
  "identifier": "com.videoeditorfree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VideoEditorFree",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; media-src 'self' asset: https://asset.localhost blob:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../../../resources/runtime/*",
      "../../../scripts/runtime/*"
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
